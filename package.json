  "repository": {
    "type": "git",
    "url": "git+https://github.com/loofare/pi-auto-thinking.git"
  },
  "homepage": "https://github.com/loofare/pi-auto-thinking",
  "pi": {
    "extensions": [
      "./extensions/auto-thinking.ts"
    ]
  },
  "peerDependencies": {
